#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const { parseVersion } = require('./release-lib.cjs');

// Get the new version from the command-line arguments
let newVersion = process.argv[2];

if (!newVersion) {
  console.error('Please provide a version as the first argument.');
  console.log(`Usage: node ${path.relative(process.cwd(), process.argv[1])} x.y.z`);
  process.exit(1);
}

// Accept explicit legacy release/v tags, v tags, or a plain version. Never
// guess a version from an arbitrary ref/path or npm's from-git lookup.
newVersion = newVersion.replace(/^(?:release\/)?v/, '');

// Validate the new version
try {
  parseVersion(newVersion);
  if (process.argv.length !== 3) throw new Error('Expected one explicit version');
} catch {
  console.error(
    'Invalid version. Please provide a version in the format x.y.z as the first argument.',
  );
  console.log(`Usage: node ${path.relative(process.cwd(), process.argv[1])} x.y.z`);
  process.exit(1);
}

// Enumerate only owned manifests. pnpm has nested dependency trees beneath
// every package, so a recursive glob can corrupt the completed dependency cache.
const files = ['package.json'];
for (const entry of fs.readdirSync('packages', { withFileTypes: true })) {
  if (!entry.isDirectory()) continue;
  const file = path.join('packages', entry.name, 'package.json');
  if (fs.existsSync(file)) files.push(file);
}
for (const file of files) {
  const pkg = JSON.parse(fs.readFileSync(file, 'utf-8'));
  pkg.version = newVersion;
  fs.writeFileSync(file, JSON.stringify(pkg, null, 2) + '\n');
}
