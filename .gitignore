# Canonical test inputs; command outputs and generated gzip files stay ignored.
!packages/sitemaps-cli/test/data/*.xml
!packages/sitemaps-cli/test/commands/convert/data/*.xml
!packages/sitemaps-cli/test/packaged/*.xml
!packages/kinesis-sitemap-writer/src/mocks/*.xml
!fixtures/packed-consumer/input.xml

