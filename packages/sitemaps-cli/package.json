{
  "name": "@shutterstock/sitemaps-cli",
  "version": "0.0.0",
  "description": "CLI for managing, generating, downloading, mirroring, and transforming XML sitemaps",
  "author": {
    "name": "Shutterstock, Inc.",
    "url": "https://github.com/shutterstock",
    "organization": true
  },
  "keywords": [
    "aws",
    "cli",
    "sitemap",
    "xml",
    "jsonl",
    "download",
    "upload",
    "create",
    "convert",
    "csv"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "sitemaps-cli": "./bin/run.js"
  },
  "scripts": {
    "clean": "shx rm -rf dist && shx rm -f tsconfig.tsbuildinfo",
    "build": "pnpm run clean && tsc --build --force && ./bin/bundle.mjs",
    "lint": "eslint .",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "NODE_ENV=production oclif manifest && NODE_ENV=production oclif readme",
    "version": "oclif readme && git add README.md"
  },
  "license": "MIT",
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json",
    "package.json",
    "LICENSE.md"
  ],
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1143.0",
    "@aws-sdk/client-kinesis": "3.1143.0",
    "@aws-sdk/client-lambda": "3.1143.0",
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/credential-providers": "3.1143.0",
    "@oclif/test": "3.2.15",
    "@shutterstock/chunker": "^1.1.0",
    "@shutterstock/kinesis-helpers": "^1.0.15",
    "@types/cli-progress": "^3.11.6",
    "@types/cloneable-readable": "^2.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/source-map-support": "^0.5.10",
    "@types/traverse": "^0.6.37",
    "cli-progress": "^3.12.0",
    "cloneable-readable": "^3.0.0",
    "csv-parse": "^7.0.3",
    "it-batch": "^1.0.9",
    "listr2": "^3.14.0",
    "node-fetch": "^2.7.0",
    "oclif": "6.0.2",
    "shx": "^0.4.0",
    "source-map-support": "^0.5.21",
    "traverse": "^0.6.11",
    "aws-sdk-client-mock": "4.1.0",
    "nock": "14.0.17",
    "esbuild": "0.28.2",
    "@types/jest": "30.0.0",
    "@shutterstock/sitemaps-utils-lib": "workspace:^",
    "ts-node": "10.9.2",
    "enquirer": "2.4.1"
  },
  "dependencies": {
    "@oclif/core": "5.1.2",
    "@oclif/plugin-help": "7.0.2",
    "@shutterstock/sitemaps-wrapper-lib": "workspace:^",
    "@shutterstock/sitemaps-models-lib": "workspace:^",
    "@shutterstock/sitemaps-db-lib": "workspace:^",
    "tslib": "^2.8.1",
    "@oclif/plugin-plugins": "7.0.3",
    "sitemap": "9.0.1",
    "fs-extra": "^11.4.1"
  },
  "oclif": {
    "bin": "sitemaps-cli",
    "dirname": "sitemaps-cli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {}
  }
}
