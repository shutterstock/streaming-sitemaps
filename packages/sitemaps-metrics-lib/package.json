{
  "name": "@shutterstock/sitemaps-metrics-lib",
  "version": "0.0.0",
  "description": "Shutterstock sitemaps metrics library - Used to create CloudWatch Dashboards for streaming sitemaps",
  "author": {
    "name": "Shutterstock, Inc.",
    "url": "https://github.com/shutterstock",
    "organization": true
  },
  "main": "dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "private": false,
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "src/**/*.ts",
    "!dist/**/*.test.*",
    "!src/**/*.test.*",
    "!dist/**/mocks/**",
    "!src/**/mocks/**",
    "!dist/**/__snapshots__/**",
    "!src/**/__snapshots__/**",
    "LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/*": [
        "dist/*"
      ],
      "*": [
        "dist/*"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shutterstock/streaming-sitemaps.git",
    "directory": "packages/sitemaps-metrics-lib"
  },
  "homepage": "https://github.com/shutterstock/streaming-sitemaps/tree/main/packages/sitemaps-metrics-lib",
  "bugs": {
    "url": "https://github.com/shutterstock/streaming-sitemaps/issues"
  }
}
